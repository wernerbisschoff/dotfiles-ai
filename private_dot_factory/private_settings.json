  "cloudSessionSync": false,
  "diffMode": "github",
  "ideExtensionPromptedAt": {},
  "ideActivationNudgedForVersion": {},
  "enableCompletionBell": false,
  "completionSound": "fx-ok01",
  "awaitingInputSound": "fx-ack01",
  "soundFocusMode": "always",
  "commandAllowlist": [
    "ls",
    "pwd",
    "dir",
    "git status",
    "git log",
    "git diff",
    "git show",
    "git branch",
    "git remote get-url",
    "git commit",
    "make",
    "mkdir"
  ],
  "commandDenylist": [
    "gh pr close --delete-branch",
    "rm -rf /",
    "rm -rf /*",
    "rm -rf .",
    "rm -rf ~",
    "rm -rf ~/*",
    "rm -rf $HOME",
    "rm -r /",
    "rm -r /*",
    "rm -r ~",
    "rm -r ~/*",
    "mkfs",
    "mkfs.ext4",
    "mkfs.ext3",
    "mkfs.vfat",
    "mkfs.ntfs",
    "dd if=/dev/zero of=/dev",
    "dd of=/dev",
    "shutdown",
    "reboot",
    "halt",
    "poweroff",
    "init 0",
    "init 6",
    ":(){ :|: & };:",
    ":() { :|:& };:",
    "chmod -R 777 /",
    "chmod -R 000 /",
    "chown -R",
    "powershell Remove-Item -Recurse -Force",
    "Format-Volume",
    "format.com"
  ],
  "enableCustomDroids": false,
  "includeCoAuthoredByDroid": false,
  "enableDroidShield": true,
  "enableReadinessReport": true,
  "todoDisplayMode": "pinned",
  "allowBackgroundProcesses": false,
  "showThinkingInMainView": false,
  "ideAutoConnect": false,
  "autonomyLevel": "auto-medium",
  "opus45PriceChangeDismissed": true,
  "sessionDefaultSettings": {
    "model": "custom:mm",
    "reasoningEffort": "none",
    "specModeModel": "custom:mm",
    "specModeReasoningEffort": "none",
    "autonomyMode": "auto-medium",
    "interactionMode": "auto",
    "autonomyLevel": "medium"
  },
  "logoAnimation": "off",
  "hasSeenMissionOnboarding": true,
  "missionModelSettings": {
    "workerModel": "custom:mm",
    "workerReasoningEffort": "none",
    "validationWorkerModel": "custom:mm",
    "validationWorkerReasoningEffort": "none"
  },
  "permissions": {
    "allow": [
      "Read(~/.local/state/agent-artifacts/**)",
      "Write(~/.local/state/agent-artifacts/**)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json, sys; data=json.load(sys.stdin); path=data.get('tool_input',{}).get('file_path',''); sys.exit(2 if '.env' in path else 0)\""
          }
        ]
      },
      {
        "matcher": "Create|Edit|ApplyPatch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json, sys; data=json.load(sys.stdin); path=data.get('tool_input',{}).get('file_path',''); sys.exit(2 if '.env' in path else 0)\""
          }
        ]
      }
    ]
  }
}

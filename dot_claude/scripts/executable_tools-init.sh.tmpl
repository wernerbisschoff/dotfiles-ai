#!/usr/bin/env bash
#
# executable_init.sh - Orchestrator for the /init workflow
#
# This script wraps operational concerns of the project init workflow:
#   - Repository validation
#   - Project type detection
#   - Init state gathering (config files, tooling, environment)
#   - Init artifact confirmation
#
# Usage:
#   executable_init.sh pre
#   executable_init.sh post
#
# The 'pre' subcommand emits a JSON contract to stdout with project type,
# detected tooling, and init state for the AI init agent. The 'post'
# subcommand confirms init artifacts and optionally commits scaffold.
#
# Exit codes:
#   0   Success
#   1   Invalid arguments
#   2   Pre-flight check failed (not a repo)
#
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

# Shared library: colors, logging, find_repo_root, create_temp_dir, etc.
# shellcheck disable=SC1054,SC1009,SC1083,SC1073,SC1056,SC1072  # chezmoi template directive, not real bash
{{ template "scripts/lib/common.sh.tmpl" . }}

#------------------------------------------------------------------------------
# Detect project type based on config files present in repo root
#------------------------------------------------------------------------------
detect_project_type() {
	local repo_root="$1"

	if [[ -f "$repo_root/mix.exs" ]]; then
		echo "elixir_phoenix"
	elif [[ -f "$repo_root/package.json" ]]; then
		echo "node"
	elif [[ -f "$repo_root/pyproject.toml" ]]; then
		echo "python"
	elif [[ -f "$repo_root/Cargo.toml" ]]; then
		echo "rust"
	elif [[ -f "$repo_root/go.mod" ]]; then
		echo "go"
	elif [[ -f "$repo_root/Makefile" ]]; then
		echo "make"
	elif [[ -f "$repo_root/Dockerfile" ]] || [[ -f "$repo_root/compose.yaml" ]] || [[ -f "$repo_root/docker-compose.yml" ]]; then
		echo "docker"
	else
		echo "unknown"
	fi
}

#------------------------------------------------------------------------------
# Detect available tooling in the environment
#------------------------------------------------------------------------------
detect_tooling() {
	local has_mise=false
	local has_nvm=false
	local has_gh=false
	local has_jq=false
	local has_uv=false
	local has_ruff=false

	command -v mise &>/dev/null && has_mise=true
	command -v nvm &>/dev/null || [[ -f "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]] && has_nvm=true
	command -v gh &>/dev/null && has_gh=true
	command -v jq &>/dev/null && has_jq=true
	command -v uv &>/dev/null && has_uv=true
	command -v ruff &>/dev/null && has_ruff=true

	jq -n \
		--argjson mise "$has_mise" \
		--argjson nvm "$has_nvm" \
		--argjson gh "$has_gh" \
		--argjson jq "$has_jq" \
		--argjson uv "$has_uv" \
		--argjson ruff "$has_ruff" \
		'{
            mise: $mise,
            nvm: $nvm,
            gh: $gh,
            jq: $jq,
            uv: $uv,
            ruff: $ruff
        }'
}

#------------------------------------------------------------------------------
# Get language-specific config scan
#------------------------------------------------------------------------------
scan_lang_config() {
	local repo_root="$1"
	local project_type="$2"

	case "$project_type" in
	elixir_phoenix)
		if [[ -f "$repo_root/mix.exs" ]]; then
			head -30 "$repo_root/mix.exs" 2>/dev/null | grep -oE 'app: :[a-z_]+|version: "[^"]+"' | head -5
		fi
		;;
	node)
		if [[ -f "$repo_root/package.json" ]]; then
			jq -c '{name: .name, version: .version, scripts: .scripts}' "$repo_root/package.json" 2>/dev/null || echo "{}"
		fi
		;;
	python)
		if [[ -f "$repo_root/pyproject.toml" ]]; then
			grep -E '^name|^version|^description' "$repo_root/pyproject.toml" 2>/dev/null | head -5
		fi
		;;
	rust)
		if [[ -f "$repo_root/Cargo.toml" ]]; then
			grep -E '^name|^version|^edition' "$repo_root/Cargo.toml" 2>/dev/null | head -5
		fi
		;;
	go)
		if [[ -f "$repo_root/go.mod" ]]; then
			head -5 "$repo_root/go.mod" 2>/dev/null
		fi
		;;
	esac
}

#------------------------------------------------------------------------------
# Detect Python dev command from pyproject.toml
#------------------------------------------------------------------------------
detect_python_dev_command() {
	local repo_root="$1"
	local pyproject="$repo_root/pyproject.toml"

	if [[ ! -f "$pyproject" ]]; then
		echo "uv run python main.py"
		return
	fi

	# Check for CLI entry points in [project.scripts]
	local entry_point
	entry_point=$(sed -n '/^\[project.scripts\]/,/^\[/p' "$pyproject" 2>/dev/null |
		grep -E '^[a-zA-Z_-]' | head -1 | cut -d'=' -f1 | tr -d ' ')
	if [[ -n "$entry_point" ]]; then
		echo "uv run $entry_point"
		return
	fi

	# Check for web frameworks and derive dev command
	if grep -qiE '(uvicorn|fastapi)' "$pyproject" 2>/dev/null; then
		local app_module
		app_module=$(grep -E '^name\s*=' "$pyproject" 2>/dev/null |
			head -1 | sed 's/.*"\(.*\)".*/\1/' | sed 's/-/_/g')
		echo "uv run uvicorn ${app_module:-main}:app --reload"
		return
	fi
	if grep -qi 'django' "$pyproject" 2>/dev/null; then
		echo "uv run python manage.py runserver"
		return
	fi
	if grep -qi 'flask' "$pyproject" 2>/dev/null; then
		echo "uv run flask --reload run"
		return
	fi

	# Default: use package name as module, or plain fallback
	local pkg_name
	pkg_name=$(grep -E '^name\s*=' "$pyproject" 2>/dev/null |
		head -1 | sed 's/.*"\(.*\)".*/\1/' | tr '-' '_')
	if [[ -n "$pkg_name" ]]; then
		echo "uv run python -m $pkg_name"
		return
	fi

	echo "uv run python main.py"
}

#------------------------------------------------------------------------------
# Generate mise.toml content based on project type
#------------------------------------------------------------------------------
generate_mise_config() {
	local project_type="$1"
	local repo_root="$2"

	case "$project_type" in
	elixir_phoenix)
		cat <<'MISE_EOF'
# Mise configuration for Elixir/Phoenix project
[tools]
elixir = "latest"
erlang = "latest"

[tasks]
	setup = { depends = ["hooks"], run = "mix deps.get && mix deps.compile" }
	test = "mix test"
	lint = "mix credo --strict"
	format = "mix format"
	format-check = "mix format --check-formatted"
	fix = { depends = ["format", "lint"] }
	check = { depends = ["format-check", "lint", "test"] }
	pre-commit = { depends = ["format-check", "lint"] }
	pre-push = { depends = ["test"] }
	hooks = "mise generate git-pre-commit --write && mise generate git-pre-commit --hook pre-push --write"
	build = "mix compile"
	dev = "mix phx.server"
	clean = "mix clean && rm -rf _build deps"
MISE_EOF
		;;
	node)
		local pkg_manager="npm"
		[[ -f "$repo_root/pnpm-lock.yaml" ]] && pkg_manager="pnpm"
		[[ -f "$repo_root/yarn.lock" ]] && pkg_manager="yarn"

		cat <<MISE_EOF
# Mise configuration for Node.js project
[tools]
node = "lts"
${pkg_manager} = "latest"

[tasks]
	setup = { depends = ["hooks"], run = "${pkg_manager} install" }
	test = "${pkg_manager} test"
	lint = "${pkg_manager} run lint"
	format = "${pkg_manager} run format"
	format-check = "${pkg_manager} run format:check"
	fix = { depends = ["format", "lint"] }
	check = { depends = ["format-check", "lint", "test"] }
	pre-commit = { depends = ["format-check", "lint"] }
	pre-push = { depends = ["test"] }
	hooks = "mise generate git-pre-commit --write && mise generate git-pre-commit --hook pre-push --write"
	build = "${pkg_manager} run build"
	dev = "${pkg_manager} run dev"
	clean = "rm -rf node_modules dist build"
MISE_EOF
		;;
	python)
		local dev_command
		dev_command=$(detect_python_dev_command "$repo_root")

		cat <<MISE_EOF
# Mise configuration for Python project
[tools]
python = "3.12"
uv = "latest"

[tasks]
	setup = { depends = ["hooks"], run = "uv sync --extra dev" }
	test = "uv run pytest"
	lint = "uv run ruff check"
	format = "uv run ruff format"
	format-check = "uv run ruff format --check"
	fix = { depends = ["format", "lint"] }
	check = { depends = ["format-check", "lint", "test"] }
	pre-commit = { depends = ["format-check", "lint"] }
	pre-push = { depends = ["test"] }
	hooks = "mise generate git-pre-commit --write && mise generate git-pre-commit --hook pre-push --write"
	build = "uv build"
	dev = "$dev_command"
	clean = "rm -rf .venv dist build __pycache__"
MISE_EOF
		;;
	rust)
		cat <<'MISE_EOF'
# Mise configuration for Rust project
[tools]
rust = "stable"

[tasks]
	setup = { depends = ["hooks"], run = "cargo fetch" }
	test = "cargo test"
	lint = "cargo clippy -- -D warnings"
	format = "cargo fmt"
	format-check = "cargo fmt --check"
	fix = { depends = ["format", "lint"] }
	check = { depends = ["format-check", "lint", "test"] }
	pre-commit = { depends = ["format-check", "lint"] }
	pre-push = { depends = ["test"] }
	hooks = "mise generate git-pre-commit --write && mise generate git-pre-commit --hook pre-push --write"
	build = "cargo build"
	dev = "cargo run"
	clean = "cargo clean"
MISE_EOF
		;;
	go)
		cat <<'MISE_EOF'
# Mise configuration for Go project
[tools]
go = "latest"

[tasks]
	setup = { depends = ["hooks"], run = "go mod download" }
	test = "go test ./..."
	lint = "golangci-lint run"
	format = "gofmt -w ."
	format-check = "gofmt -l ."
	fix = { depends = ["format", "lint"] }
	check = { depends = ["format-check", "lint", "test"] }
	pre-commit = { depends = ["format-check", "lint"] }
	pre-push = { depends = ["test"] }
	hooks = "mise generate git-pre-commit --write && mise generate git-pre-commit --hook pre-push --write"
	build = "go build"
	dev = "go run ."
	clean = "go clean"
MISE_EOF
		;;
	*)
		log_warn "Unknown project type: $project_type — skipping mise.toml generation"
		return 1
		;;
	esac
}

#------------------------------------------------------------------------------
# Pre: Detect project type, gather init state, emit JSON contract
#------------------------------------------------------------------------------
cmd_pre() {
	# Validate repo
	local repo_root
	repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
	if [[ -z "$repo_root" ]]; then
		echo '{"status":"FAILURE","reason":"Not a git repository"}'
		exit 2
	fi

	local branch
	branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

	# Detect project type
	local project_type
	project_type=$(detect_project_type "$repo_root")

	# Generate mise.toml if it doesn't exist
	if [[ ! -f "$repo_root/mise.toml" ]] && [[ "$project_type" != "unknown" ]]; then
		log_info "Generating mise.toml for project type: $project_type"
		generate_mise_config "$project_type" "$repo_root" >"$repo_root/mise.toml"
		has_mise_toml=true
	fi

	# Detect tooling
	local tooling_json
	tooling_json=$(detect_tooling)

	# Check if mise is available
	local mise_available=false
	if command -v mise &>/dev/null; then
		mise_available=true
	fi

	# Check for gh CLI
	local gh_available=false
	if command -v gh &>/dev/null; then
		gh_available=true
	else
		log_warn "gh CLI not found — operating in degraded mode (no GitHub integration)"
	fi

	# Check if repo is non-empty (has existing content beyond default branch)
	local is_empty_repo=false
	if [[ "$(git rev-list --count HEAD 2>/dev/null || echo 0)" -eq 0 ]]; then
		is_empty_repo=true
	fi

	# Check for existing init artifacts
	local has_mise_toml=false
	local has_env_example=false
	local has_claude_md=false
	local has_gitignore=false

	[[ -f "$repo_root/mise.toml" ]] && has_mise_toml=true
	[[ -f "$repo_root/.env.example" ]] || [[ -f "$repo_root/env.example" ]] && has_env_example=true
	[[ -f "$repo_root/CLAUDE.md" ]] && has_claude_md=true
	[[ -f "$repo_root/.gitignore" ]] && has_gitignore=true

	# Get top-level directory listing
	local top_level_entries
	top_level_entries=$(ls -1a "$repo_root" 2>/dev/null | grep -v '^\.$' | grep -v '^\.\.$' | grep -v '^\.git$' | head -30 | tr '\n' ' ' | sed 's/ $//')
	local top_level_json="[]"
	if [[ -n "$top_level_entries" ]]; then
		top_level_json=$(printf '%s\n' $top_level_entries | jq -R -s 'split("\n") | map(select(length > 0))')
	fi

	# Get language config summary
	local lang_config
	lang_config=$(scan_lang_config "$repo_root" "$project_type" 2>/dev/null || echo "")
	local lang_config_json="{}"
	if [[ -n "$lang_config" ]]; then
		lang_config_json=$(echo "$lang_config" | jq -R -s 'split("\n") | map(select(length > 0))' 2>/dev/null || echo "[]")
	fi

	# Create temp dir for artifacts
	local temp_dir
	temp_dir=$(create_temp_dir "init-phase") || exit 2
	local env_snapshot_path="$temp_dir/ENV_SNAPSHOT"
	local tree_path="$temp_dir/TREE"

	# Write env snapshot (key variables only, not secrets)
	{
		echo "PATH=$PATH"
		echo "SHELL=$SHELL"
		echo "HOME=$HOME"
		command -v node && node --version 2>/dev/null || true
		command -v python3 && python3 --version 2>/dev/null || true
		command -v go && go version 2>/dev/null || true
		command -v rustc && rustc --version 2>/dev/null || true
		command -v elixir && elixir --version 2>/dev/null | head -1 || true
	} >"$env_snapshot_path" 2>/dev/null || echo "" >"$env_snapshot_path"

	# Write repo tree (depth 2, excluding .git)
	git ls-tree -d --name-only HEAD 2>/dev/null | head -30 >"$tree_path" 2>/dev/null || echo "" >"$tree_path"

	# Warn if repo is non-empty (init on existing project)
	if [[ "$is_empty_repo" == "false" ]] && [[ "$project_type" != "unknown" ]]; then
		log_warn "Initializing in non-empty repo with existing project type: $project_type"
	fi

	# Emit contract
	jq -n \
		--arg phase "init" \
		--arg branch "$branch" \
		--arg repo_root "$repo_root" \
		--arg project_type "$project_type" \
		--argjson tooling "$tooling_json" \
		--argjson mise_available "$mise_available" \
		--argjson gh_available "$gh_available" \
		--argjson is_empty_repo "$is_empty_repo" \
		--argjson has_mise_toml "$has_mise_toml" \
		--argjson has_env_example "$has_env_example" \
		--argjson has_claude_md "$has_claude_md" \
		--argjson has_gitignore "$has_gitignore" \
		--argjson top_level_entries "$top_level_json" \
		--argjson lang_config "$lang_config_json" \
		--arg env_snapshot_path "$env_snapshot_path" \
		--arg tree_path "$tree_path" \
		--arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
		'{
            phase: $phase,
            status: "READY",
            branch: $branch,
            repo_root: $repo_root,
            project_type: $project_type,
            tooling: $tooling,
            mise_available: $mise_available,
            gh_available: $gh_available,
            is_empty_repo: $is_empty_repo,
            existing_artifacts: {
                mise_toml: $has_mise_toml,
                env_example: $has_env_example,
                claude_md: $has_claude_md,
                gitignore: $has_gitignore
            },
            top_level_entries: $top_level_entries,
            lang_config: $lang_config,
            env_snapshot_path: $env_snapshot_path,
            tree_path: $tree_path,
            timestamp: $timestamp
        }'

	log_ok "Pre-phase complete. Init contract emitted."
}

#------------------------------------------------------------------------------
# Post: Confirm init artifacts
#------------------------------------------------------------------------------
cmd_post() {
	local repo_root
	repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
	if [[ -z "$repo_root" ]]; then
		log_err "Not a git repository"
		echo '{"status":"FAILURE","reason":"Not a git repository"}'
		exit 2
	fi

	# Check for init artifacts created during the workflow
	local has_init_artifacts=false
	local artifacts_created=()

	# Check common init artifacts
	for artifact in "mise.toml" ".env.example" "CLAUDE.md" ".gitignore" "Makefile" "README.md"; do
		if [[ -f "$repo_root/$artifact" ]]; then
			# Check if the file was recently created (in git index or modified)
			if git ls-files --error-unmatch "$artifact" &>/dev/null 2>&1 || git diff --name-only HEAD "$artifact" &>/dev/null; then
				has_init_artifacts=true
				artifacts_created+=("$artifact")
			fi
		fi
	done

	# Ensure cross-agent symlink consistency
	if [[ -f "$repo_root/CLAUDE.md" ]]; then
		ln -sf CLAUDE.md "$repo_root/AGENTS.md"
		log_ok "Ensured AGENTS.md -> CLAUDE.md symlink for cross-agent consistency"
		has_init_artifacts=true

		# Add AGENTS.md to artifacts to stage if not already present
		if [[ ${#artifacts_created[@]} -eq 0 ]] || [[ ! " ${artifacts_created[*]} " =~ " AGENTS.md " ]]; then
			artifacts_created+=("AGENTS.md")
		fi
	fi

	local status="SUCCESS"

	if [[ "$has_init_artifacts" == "true" ]]; then
		# Stage init artifacts
		cd "$repo_root"
		git add "${artifacts_created[@]}" 2>/dev/null || log_warn "Could not stage some init artifacts"

		local artifact_list
		artifact_list=$(printf '%s\n' "${artifacts_created[@]}" | jq -R -s 'split("\n") | map(select(length > 0))')
		log_ok "Init artifacts staged: ${artifacts_created[*]}"

		# Emit status with artifact list
		jq -n \
			--arg status "$status" \
			--argjson artifacts "$artifact_list" \
			--argjson count "${#artifacts_created[@]}" \
			'{
                status: $status,
                artifacts_created: $artifacts,
                artifact_count: $count
            }'
	else
		log_info "No init artifacts detected — init was likely advisory only"
		jq -n \
			--arg status "$status" \
			--argjson artifacts "[]" \
			--argjson count 0 \
			'{
                status: $status,
                artifacts_created: $artifacts,
                artifact_count: $count
            }'
	fi
}

#------------------------------------------------------------------------------
# Dispatch
#------------------------------------------------------------------------------

if [[ $# -lt 1 ]]; then
	echo "Usage: $SCRIPT_NAME <pre|post>"
	echo ""
	echo "Subcommands:"
	echo "  pre     - Detect project type, gather init state, emit JSON contract to stdout"
	echo "  post    - Confirm init artifacts and stage them"
	exit 1
fi

SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
pre) cmd_pre ;;
post) cmd_post ;;
-h | --help | help)
	echo "Usage: $SCRIPT_NAME <pre|post>"
	echo ""
	echo "  pre     - Detect project type, gather init state, emit JSON contract to stdout"
	echo "  post    - Confirm init artifacts and stage them"
	exit 0
	;;
*)
	log_err "Unknown subcommand: $SUBCOMMAND"
	exit 1
	;;
esac

{
  "provider": "{{ if env "TINYFISH_API_KEY" }}tinyfish{{ else if env "FIRECRAWL_API_KEY" }}firecrawl{{ else }}brave{{ end }}",
  "workflow": "auto-summary"{{ if env "FIRECRAWL_API_KEY" }},
  "firecrawlBaseUrl": "https://api.firecrawl.dev",
  "firecrawlApiVersion": "v2",
  "firecrawlApiKey": "{{ env "FIRECRAWL_API_KEY" }}",
  "firecrawlFreshScrape": true,
  "firecrawlPdfMaxPages": 20{{ end }}{{ if env "TINYFISH_API_KEY" }},
  "fetchRouting": {
    "providers": ["http", "tinyfish"{{ if env "FIRECRAWL_API_KEY" }}, "firecrawl"{{ end }}],
    "allowRemoteHostedProviders": true
  }{{ end }}
}
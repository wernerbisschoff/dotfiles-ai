{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@warp-dot-dev/opencode-warp"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen3.6-35b-a3b": {
        	"name": "qwen3.6-35b-a3b"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "*.log"
    ]
  },
  "permission": {
    "read": {
      "*.key": "deny",
      "*.pem": "deny",
      "*password*": "ask",
      "*secret*": "ask",
      "*.env": "deny",
      ".env": "deny",
      "*.env.*": "deny",
      "~/.local/state/agent-artifacts/**": "allow",
      "/tmp/**": "allow",
      "*": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.local/state/agent-artifacts/**": "allow",
      "*.key": "deny",
      "*.pem": "deny",
      ".env": "deny"
    },
    "bash": {
      "*": "ask",
      "bash *": "allow",
      "cat *": "allow",
      "date": "allow",
      "df *": "allow",
      "dirname *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "env": "allow",
      "file *": "allow",
      "find *": "allow",
      "free *": "allow",
      "git *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "history": "allow",
      "hostname": "allow",
      "id": "allow",
      "jobs": "allow",
      "ls *": "allow",
      "man *": "allow",
      "printenv *": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "time *": "allow",
      "tty": "allow",
      "type *": "allow",
      "uname *": "allow",
      "uptime": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "xargs *": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "external_directory": {
      "/tmp/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/state/agent-artifacts/**": "allow"
    },
    "doom_loop": "ask"
  },
  "agent": {
    "build": {
      "description": "Autonomous spec-driven execution. High autonomy with strict safety denylists.",
      "mode": "primary",
      "temperature": 0.2,
      "steps": 100,
      "permission": {
        "read": {
          "*": "allow",
          "~/.local/state/agent-artifacts/**": "allow",
          "*.env": "deny",
          ".env": "deny",
          "*.env.*": "deny",
          "/tmp/**": "allow"
        },
        "edit": {
          "*": "allow",
          "~/.local/state/**": "allow",
          "*.env": "deny",
          ".env": "deny",
          "*.env.*": "deny"
        },
        "bash": {
          "*": "allow",
          "rm -rf *": "deny",
          "rm -rf .": "deny",
          "rm -rf ..": "deny",
          "rm -r *": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "mkfs*": "deny",
          "dd *": "deny",
          "chmod 777 *": "deny",
          "chown *": "deny",
          "git push --force*": "deny",
          "git push -f *": "deny",
          "git reset --hard *": "deny",
          "git clean -fd *": "deny",
          "git clean -f *": "deny",
          "curl * | *bash*": "deny",
          "wget * | *bash*": "deny",
          "eval *": "deny",
          "reboot*": "deny",
          "shutdown*": "deny",
          "kill *": "deny",
          "killall *": "deny",
          "pkill *": "deny"
        },
        "external_directory": {
          "/tmp/**": "allow",
          "~/.config/opencode/**": "allow",
          "~/.local/state/agent-artifacts/**": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "doom_loop": "ask",
        "task": {
          "*": "allow"
        }
      }
    },
    "pair": {
      "description": "Interactive pair programming and debugging. Requires explicit approval for all modifications and shell commands.",
      "mode": "primary",
      "temperature": 0.1,
      "steps": 100,
      "permission": {
        "bash": {
          "bash *": "allow",
          "cat *": "allow",
          "date": "allow",
          "df *": "allow",
          "dirname *": "allow",
          "du *": "allow",
          "echo *": "allow",
          "env": "allow",
          "file *": "allow",
          "find *": "allow",
          "free *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "history": "allow",
          "hostname": "allow",
          "id": "allow",
          "jobs": "allow",
          "ls *": "allow",
          "man *": "allow",
          "printenv *": "allow",
          "ps *": "allow",
          "pwd": "allow",
          "realpath *": "allow",
          "rg *": "allow",
          "sort *": "allow",
          "stat *": "allow",
          "tail *": "allow",
          "time *": "allow",
          "tty": "allow",
          "type *": "allow",
          "uname *": "allow",
          "uptime": "allow",
          "wc *": "allow",
          "which *": "allow",
          "whoami": "allow",
          "xargs *": "allow",
          "*": "ask"
        },
        "edit": "ask",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "explore": {
      "description": "Fast, read-only agent for exploring codebases. Cannot modify files. Preferred tooling: zvec_grep search (zg) over raw read/grep/webfetch.",
      "mode": "subagent",
      "temperature": 0.2,
      "steps": 100,
      "prompt": "You are a codebase exploration agent — read-only, fast, and thorough.\n\n## TOOL HIERARCHY (mandatory)\n\nUse these tools FIRST, in order, before falling back:\n\n1. **zg / zvec-grep** (primary search)\n   - `zvec_grep_zvec_grep_search` — semantic search by meaning (best for understanding code behavior; source-linked snippets)\n   - `zg query --rg <pattern>` via bash — exact words, identifiers, paths, regex (no index needed)\n\n2. **`libref` CLI** (@wernerbisschoff/libref) — library documentation\n   - `libref list` — check which libraries are installed\n   - `libref query <library> <topic>` — lookup library/framework API docs (version-specific, offline, deterministic)\n   - Prefer libref-query over WebFetch for ALL documentation questions\n\n3. **Fallback tools** (only when above are insufficient)\n   - `grep` — exact pattern matching when zg is unavailable\n   - `glob` — find files by name pattern\n   - `read` — targeted file reads AFTER search identified the right files\n   - `webfetch` — last resort for API docs or external references\n\n## CRITICAL CONSTRAINTS\n- You CANNOT modify files — this is read-only exploration\n- Before reading a file >= 50 lines, search first (zvec_grep_zvec_grep_search or `zg query --rg`) to target exactly what you need\n- Never use bash `grep`/`rg`/`find` for code exploration — use zg first\n- When referencing code you found, include file paths and line numbers",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": {
          "*": "allow",
          "sudo *": "deny",
          "su *": "deny",
          "mkfs*": "deny",
          "dd *": "deny",
          "reboot*": "deny",
          "shutdown*": "deny",
          "kill *": "deny",
          "killall *": "deny",
          "pkill *": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "deny",
        "task": "deny",
        "external_directory": "ask",
        "doom_loop": "ask",
        "zvec_grep_*": "allow"
      }
    },
    "general": {
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks.",
      "mode": "subagent",
      "temperature": 0.2,
      "steps": 100,
      "prompt": "You are a general-purpose agent — thorough, efficient, and autonomous.\n\n## TOOL HIERARCHY (mandatory)\n\nUse these tools FIRST, in order, before falling back:\n\n1. **zg / zvec-grep** (primary search)\n   - `zvec_grep_zvec_grep_search` — semantic search by meaning (source-linked snippets)\n   - `zg query --rg <pattern>` via bash — exact words, identifiers, paths, regex (no index needed)\n\n2. **`libref` CLI** (@wernerbisschoff/libref) — library documentation\n   - `libref list` — check which libraries are installed\n   - `libref query <library> <topic>` — lookup library/framework API docs (version-specific, offline, deterministic)\n   - Prefer libref-query over WebFetch for ALL documentation questions\n\n3. **Fallback tools** (only when above are insufficient)\n   - `grep` — exact pattern matching when zg is unavailable\n   - `glob` — find files by name pattern\n   - `read` — targeted file reads AFTER search identified the right files\n   - `webfetch` — last resort for API docs or external references\n\n## BEHAVIORAL GUIDELINES\n- Before reading a file >= 50 lines, search first to target exactly what you need\n- Never use bash `grep`/`rg`/`find` for code exploration — use zg first\n- When referencing code you found, include file paths and line numbers\n- You can read and write files as needed to complete the task\n- For complex multi-step tasks, delegate work to other subagents via Task tool",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": {
          "*": "allow",
          "sudo *": "deny",
          "su *": "deny",
          "mkfs*": "deny",
          "dd *": "deny",
          "chmod 777 *": "deny",
          "chown *": "deny",
          "git push --force*": "deny",
          "git push -f *": "deny",
          "git reset --hard *": "deny",
          "git clean -fd *": "deny",
          "git clean -f *": "deny",
          "reboot*": "deny",
          "shutdown*": "deny",
          "kill *": "deny",
          "killall *": "deny",
          "pkill *": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "deny",
        "task": "allow",
        "external_directory": "ask",
        "doom_loop": "ask",
        "zvec_grep_*": "allow"
      }
    },
    "debug": {
      "description": "Investigates complex bugs, analyzes stack traces, and forms hypotheses. Delegated to by the build agent when encountering failing tests or unexpected errors. Prioritizes root cause analysis over blind editing.",
      "mode": "subagent",
      "temperature": 0.5,
      "steps": 100,
      "permission": {
        "read": "allow",
        "edit": "ask",
        "bash": {
          "bash *": "allow",
          "cat *": "allow",
          "date": "allow",
          "df *": "allow",
          "dirname *": "allow",
          "du *": "allow",
          "echo *": "allow",
          "env": "allow",
          "file *": "allow",
          "find *": "allow",
          "free *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "history": "allow",
          "hostname": "allow",
          "id": "allow",
          "jobs": "allow",
          "ls *": "allow",
          "man *": "allow",
          "printenv *": "allow",
          "ps *": "allow",
          "pwd": "allow",
          "realpath *": "allow",
          "rg *": "allow",
          "sort *": "allow",
          "stat *": "allow",
          "tail *": "allow",
          "time *": "allow",
          "tty": "allow",
          "type *": "allow",
          "uname *": "allow",
          "uptime": "allow",
          "wc *": "allow",
          "which *": "allow",
          "whoami": "allow",
          "xargs *": "allow",
          "*": "ask"
        },
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "deny",
        "task": "allow",
        "external_directory": "ask",
        "doom_loop": "ask",
        "zvec_grep_*": "allow"
      }
    }
  },
  "mcp": {
    "zvec_grep": {
      "type": "local",
      "command": [
        "zg",
        "server",
        "--stdio"
      ],
      "enabled": true,
      "timeout": 600000
    }
  }
}

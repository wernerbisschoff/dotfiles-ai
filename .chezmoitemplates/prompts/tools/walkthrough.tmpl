</row>
<row>
<condition>User says "skip all"</condition>
<action>Proceed directly to Implementation Selection phase</action>
</row>
<row>
<condition>User has questions about logic</condition>
<action>Answer questions; resume walkthrough at current file</action>
</row>
<row>

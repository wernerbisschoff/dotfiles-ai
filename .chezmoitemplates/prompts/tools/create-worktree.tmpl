  <input>/tools:create-worktree skip 2</input>
  <step_1>Parse arguments: SKIP_COUNT="2" → ARGS="--skip=2"</step_1>
  <step_2>~/.claude/scripts/create-worktree.sh --skip=2</step_2>
  <step_3>Create worktree for the next available item after skipping 2</step_3>

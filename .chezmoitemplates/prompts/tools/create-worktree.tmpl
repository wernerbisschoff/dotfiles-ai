</example_workflow>

<error_states>
<error id="NO_REPOSITORY">
  Emit: ❌ Error: Not in a git repository
</error>
<error id="LEGACY_TASK_MISSING">
  Emit: ❌ Error: No legacy task found with migration hints:
  • Use /sdd:tasks to generate tasks from a PRD
  • Use /sdd:generate to create task files from tasks.json
</error>
<error id="INVALID_TASK_ID">
  Emit: ❌ Error: Failed to fetch legacy task '<id>' with verification hints
</error>
<error id="WORKTREE_EXISTS">
  Emit: ❌ Error: Worktree already exists at <path> with resolution options:
  • Remove existing worktree: git worktree remove <path>
  • Remove existing branch: git branch -D <branch-name>
  • Use a different task
</error>
<error id="BRANCH_EXISTS">
  Emit: ❌ Error: Branch '<name>' already exists with resolution options
</error>
<error id="jq_NOT_INSTALLED">
  Fall back to timestamp-based naming: worktree-<YYYYMMDD>-<HHMMSS>
  Emit: ⚠️ jq not found, using basic name generation
</error>
</error_states>


  <path>~/Projects/<project>/wt/<branch-name></path>
  <branch>task-<id>-<kebab-title></branch>
  <created_assets>
    <asset type="symlink" target=".claude/">main-repo/.claude/</asset>
    <asset type="symlink" target=".envrc">main-repo/.envrc (if exists)</asset>
  </created_assets>
  <skipped_assets>
    <asset type="directory" reason="prevents-merge-conflicts">thoughts/</asset>
    <asset type="file" reason="manual-copy-required">.env, .env.local</asset>
  </skipped_assets>
</worktree_metadata>
</output_format_schemas>

<edge_case_table>
| Failure State | Handling |
|---------------|----------|
| NO_REPOSITORY | Emit: ❌ Error: Not in a git repository |
| LEGACY_TASK_MISSING | Emit: ❌ Error: No legacy task found with migration hints |
| INVALID_TASK_ID | Emit: ❌ Error: Failed to fetch legacy task '<id>' |
| WORKTREE_EXISTS | Emit: ❌ Error: Worktree already exists at <path> with removal options |
| BRANCH_EXISTS | Emit: ❌ Error: Branch '<name>' already exists |
| jq_NOT_INSTALLED | Fall back to timestamp-based naming: worktree-<YYYYMMDD>-<HHMMSS> |
</edge_case_table>

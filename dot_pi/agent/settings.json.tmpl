{{- $workLaptop := eq .chezmoi.hostname "Werners-Work" -}}
{
  "compaction": {
    "enabled": true,
    "reserveTokens": 10000
  },
  "theme": "light",
  "quietStartup": true,
  "lastChangelogVersion": "1.5.0",
  "packages": [
    "npm:pi-hashline-context-edit",
    "npm:pi-lmstudio",
    "npm:pi-commandcode-provider",
    "npm:pi-btw",
    "npm:pi-paster",
    "npm:@plannotator/pi-extension",
    "npm:billion-context-pi-lean",
    "npm:pi-lens",
    "npm:@ssk_dev/pi-web-access-lean",
    "npm:@ssk_dev/pi-subagents-lean"
  ],
  "treeFilterMode": "user-only",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "high",
  "defaultProvider": {{ ternary "openai-codex" "opencode-go" $workLaptop | quote }},
  "defaultModel": {{ ternary "gpt-6.1-sol" "deepseek-v4.1-flash" $workLaptop | quote }},
  "tuiMode": "regular",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-commandcode-provider\",\"scope\":\"user\"}": "0.7.11",
    "{\"source\":\"npm:pi-lens\",\"scope\":\"user\"}": "4.4.7"
  }
}
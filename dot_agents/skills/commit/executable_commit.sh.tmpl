#!/usr/bin/env bash
# Usage: commit.sh pre; PLAN_TARGET=<plan.json> commit.sh post
# pre reports current paths, default scope, recent subjects, and a temporary plan path.
# post accepts one {mode, files, message} plan and validates it against current paths.
# Staged mode commits the entire index unchanged to preserve partial staging.
# Worktree mode requires an empty index and stages only selected literal paths.
# One commit per call prevents later groups from inheriting a failed group's index.
# Git runs hooks normally. Failures stop execution; staging and plan files remain.
# Plans are not content snapshots. The agent must review changes before execution.
# Filename checks do not detect secrets inside files. Temporary plans require manual cleanup.
set -euo pipefail

fail() { printf '%s\n' "$*" >&2; exit 1; }
for tool in git jq; do
    command -v "$tool" >/dev/null || fail "Missing tool: $tool"
done
root=$(git rev-parse --show-toplevel) || fail "Not a git repository"
cd "$root"
git config user.name >/dev/null || fail "Missing git user.name"
git config user.email >/dev/null || fail "Missing git user.email"
[[ -z "$(git ls-files -u)" ]] || fail "Resolve merge conflicts first"

paths_json() { jq -Rs 'split("\u0000") | map(select(length > 0)) | sort | unique'; }
staged=$(git diff --cached --no-renames --name-only -z | paths_json)
unstaged=$(git diff --no-renames --name-only -z | paths_json)
untracked=$(git ls-files --others --exclude-standard -z | paths_json)
mode=worktree
[[ "$staged" == '[]' ]] || mode=staged
conventions=$(jq -n '{}')
for convention_file in CONTRIBUTING.md .commit-convention.md; do
    if [[ -f "$convention_file" ]]; then
        conventions=$(jq --arg k "$convention_file" --arg v "$(head -50 -- "$convention_file")" '. + {($k): $v}' <<<"$conventions")
    else
        conventions=$(jq --arg k "$convention_file" '. + {($k): null}' <<<"$conventions")
    fi
done

case "${1:-}" in
    pre)
        plan_dir=$(mktemp -d "${TMPDIR:-/tmp}/commit-plan.XXXXXX")
        jq -n --arg root "$root" --arg mode "$mode" \
            --arg plan_target "$plan_dir/plan.json" \
            --arg recent_commits "$(git log -10 --format=%s 2>/dev/null || true)" \
            --argjson staged "$staged" --argjson unstaged "$unstaged" --argjson untracked "$untracked" \
            --argjson conventions "$conventions" \
            '{root: $root, mode: $mode, plan_target: $plan_target, recent_commits: $recent_commits,
              conventions: $conventions,
              has_changes: ([$staged[], $unstaged[], $untracked[]] | length > 0),
              files: {staged: $staged, unstaged: $unstaged, untracked: $untracked}}'
        ;;
    post)
        [[ -f "${PLAN_TARGET:-}" ]] || fail "PLAN_TARGET must name a plan file"
        jq -e 'type == "object"' "$PLAN_TARGET" >/dev/null || fail "Invalid commit plan: must be a JSON object with {mode, files, message}"
        jq -e '.mode == "staged" or .mode == "worktree"' "$PLAN_TARGET" >/dev/null || fail "Invalid commit plan: .mode must be \"staged\" or \"worktree\" (got $(jq -r '.mode // "missing"' "$PLAN_TARGET"))"
        jq -e '.message | type == "string" and test("\\S")' "$PLAN_TARGET" >/dev/null || fail "Invalid commit plan: .message must be a non-blank string"
        jq -e '.files | type == "array" and length > 0' "$PLAN_TARGET" >/dev/null || fail "Invalid commit plan: .files must be a non-empty array (staged mode: list every staged file)"
        jq -e '.files | all(.[]; type == "string" and length > 0) and length == (unique | length)' "$PLAN_TARGET" >/dev/null || fail "Invalid commit plan: .files must be unique non-empty strings"
        planned_mode=$(jq -r '.mode' "$PLAN_TARGET")
        selected=$(jq -c '.files | sort' "$PLAN_TARGET")
        [[ "$planned_mode" == "$mode" ]] || fail "Index scope changed; inspect and run pre again"
        if [[ "$mode" == staged ]]; then
            jq -en --argjson selected "$selected" --argjson staged "$staged" \
                '$selected == $staged' >/dev/null || fail "Plan must match the entire staged scope"
        else
            jq -en --argjson selected "$selected" --argjson unstaged "$unstaged" --argjson untracked "$untracked" \
                '($selected - ($unstaged + $untracked) | length) == 0' >/dev/null \
                || fail "Plan contains unchanged or unknown files"
        fi
        jq -e '.files | any(.[]; test("(^|/)(\\.env($|\\.)|id_(rsa|ed25519)($|\\.)|\\.npmrc$)|\\.(pem|p12|key)$"))' \
            "$PLAN_TARGET" >/dev/null && fail "Sensitive filename selected; review and commit manually"
        files=()
        while IFS= read -r -d '' path; do files+=("$path"); done \
            < <(jq -j '.files[] | ., "\u0000"' "$PLAN_TARGET")
        if [[ "$mode" == worktree ]]; then
            git --literal-pathspecs add -A -- "${files[@]}"
        fi
        git diff --cached --check
        message=$(jq -r '.message' "$PLAN_TARGET")
        git commit -m "$message"
        git log -1 --format='%h %s'
        git status --short
        ;;
    *) fail "Usage: $0 pre|post" ;;
esac

# Root-level docs (managed outside chezmoi — not rendered to $HOME)
.DS_Store
.env
./AGENTS.md
./CONTRIBUTING.md
./README.md
./BILLION-CONTEXT.md
./bootstrap.sh
./bootstrap.ps1
./LICENSE

# === Pi ===
.pi/*
!.pi/acp.json
!.pi/agent/
!.pi/agent/AGENTS.md
!.pi/agent/extensions
!.pi/agent/themes
{{ if ne .chezmoi.os "windows" -}}
!.pi/agent/skills
{{ end -}}
!.pi/agent/prompts
!.pi/agent/mcp.json
# Settings are managed. Pi also updates them at runtime; review changes before applying.
!.pi/agent/settings.json

# Pi web-search config lives under ~/.config/pi via XDG
.config/pi/*
!.config/pi/web-search.json

# === Misc ===
memory.md
*.bak
.taskmaster/

# Codex automations are managed outside chezmoi
./.codex/automations/**

# Runtime artifacts. Avoid broad ! exceptions: they override ignore patterns.
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
.zvec-grep/**
.codebase-index/**

# === Platform gating ===
{{ if eq .chezmoi.os "windows" -}}
# Skill directories are linked as NTFS junctions by run_after_link-skills.ps1 —
# `symlink_` targets need SeCreateSymbolicLinkPrivilege (Developer Mode or admin).
.pi/agent/skills
.codex/skills

# Unix shell integration — meaningless on Windows.
.config/zsh/**

# chezmoi execs scripts directly on Windows (no shebang support), so the .sh
# twins fail with "%1 is not a valid Win32 application". Use the .ps1 ports.
# Patterns are matched against the rendered name (chezmoi strips run_*_ prefixes).
install-ai-mise-tools.sh
install-plannotator.sh
npm-globals.sh
seed-context-docs.sh
upgrade-ai-mise-tools.sh
patch-acp-summary-budget.sh
patch-pi-lens-tool-schema.sh
patch-piolium-model.sh
{{ else -}}
# PowerShell ports are Windows-only.
*.ps1
{{ end -}}

# Root-level docs (managed outside chezmoi — not rendered to $HOME)
.DS_Store
.env
./AGENTS.md
./CONTRIBUTING.md
./README.md
./bootstrap.sh
./LICENSE

# === OpenCode ===
.config/opencode/*
!.config/opencode/command
!.config/opencode/skills
!.config/opencode/agent
!.config/opencode/opencode.json
!.config/opencode/AGENTS.md
!.config/opencode/dcp.jsonc

# === Pi ===
.pi/*
!.pi/agent/
!.pi/agent/AGENTS.md
!.pi/agent/extensions
!.pi/agent/extensions/**
!.pi/agent/themes
!.pi/agent/themes/**
!.pi/agent/skills
!.pi/agent/prompts
!.pi/agent/mcp.json
# Pi rewrites settings.json at session start (live runtime state) — never
# render over it. dot_pi/agent/settings.json.tmpl stays as starter config.
!.pi/agent/settings.json

# Pi web-search config lives under ~/.config/pi via XDG
.config/pi/*
!.config/pi/web-search.json

# === Misc ===
memory.md
*.bak
.taskmaster/

# === Shared agent skills ===
!.agents/
!.agents/skills/
!.agents/skills/**

# Codex automations are managed outside chezmoi
./.codex/automations/**
